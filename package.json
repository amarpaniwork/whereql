{
  "name": "whereql",
  "version": "0.1.0",
  "description": "A small filter-expression language with two agreeing backends: parse once, then translate to SQL or evaluate in memory with SQL three-valued semantics.",
  "keywords": [
    "filter",
    "dsl",
    "parser",
    "query",
    "sql",
    "predicate",
    "odata"
  ],
  "license": "ISC",
  "//type": "CommonJS deliberately: every consumer today is CJS, and an ESM-only package would fail there with ERR_REQUIRE_ESM. Revisit as a dual build only when an ESM consumer actually exists.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/jest": "latest",
    "@types/node": "latest",
    "jest": "latest",
    "ts-jest": "latest",
    "typescript": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amarpaniwork/whereql.git"
  },
  "bugs": {
    "url": "https://github.com/amarpaniwork/whereql/issues"
  },
  "homepage": "https://github.com/amarpaniwork/whereql#readme"
}
